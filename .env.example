# Reown AppKit project id (https://dashboard.reown.com). Required for wallet connection.
VITE_REOWN_PROJECT_ID=

# Optional: Solana RPC endpoint for balances and activity.
# Defaults to Reown RPC when VITE_REOWN_PROJECT_ID is set, otherwise solana-rpc.publicnode.com.
VITE_SOLANA_RPC_URL=

# Optional: Hushlane service fee, collected through the NEAR Intents 1Click appFees field.
# VITE_FEE_RECIPIENT is a NEAR account (e.g. yourname.near). Leave empty to charge no service fee.
VITE_FEE_RECIPIENT=
VITE_FEE_BPS=30

# Optional: NEAR Intents 1Click partner JWT. Without it 1Click adds its own small fee.
# Note: anything prefixed VITE_ ends up in the public browser bundle.
VITE_ONECLICK_JWT=
